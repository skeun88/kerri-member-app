{
  "expo": {
    "name": "KERRI Member",
    "slug": "kerri-member",
    "owner": "skeun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.kerri.memberapp",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kerri.memberapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kerri-member",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "813fa498-10e9-4308-a7e6-da20197d1ec2"
      }
    }
  }
}
